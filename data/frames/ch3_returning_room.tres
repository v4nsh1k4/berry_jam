[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("4_npc_data")
id = &"arthur"
display_name = "Arthur"
position = Vector2(420, 404)
visual_style = &"butler"
bubbles = Array[ExtResource("5_bubble_data")]([ExtResource("6_arthur_open"), ExtResource("7_arthur_push"), ExtResource("8_arthur_wait"), ExtResource("9_arthur_help")])
lines = PackedStringArray("I used to {word} every door in this house.", "{word} the chairs in, I always said.", "{word} for me, sir. Please.", "Can you {word} me find my words?")
broken_lines = PackedStringArray("I used to... every d-door. Please.", "...the chairs in. Something's m-missing.", "...for me. P-please, give it back.", "Can you... me? Please.")
relief_lines = PackedStringArray("Oh... thank you, sir.", "That's mine. I remember it.", "I can nearly speak again.", "I'm whole. Thank you.")
plea_lines = PackedStringArray()
words_stealable = false
bubble_offsets = PackedVector2Array(-150, -205, -80, -305, 110, -225, 190, -318)

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("4_npc_data")
id = &"mrs_vane"
display_name = "Mrs. Vane"
position = Vector2(820, 404)
visual_style = &"housekeeper"
bubbles = Array[ExtResource("5_bubble_data")]([ExtResource("10_vane_hide"), ExtResource("11_vane_hush"), ExtResource("12_vane_wait")])
lines = PackedStringArray("Don't {word} from me, child.", "{word}, the page is tearing.", "{word}. Don't leave us like this.")
broken_lines = PackedStringArray("Don't... from me. P-please.", "..., the page is t-tearing...", "... Don't leave us. Please.")
relief_lines = PackedStringArray("Bless you, child.", "It sounds right again.", "There. That's my voice.")
plea_lines = PackedStringArray("You took it... I can't finish my sentences.", "Every word you took left a hole in me.", "I keep reaching for it and it isn't there.")
words_stealable = false
bubble_offsets = PackedVector2Array(-110, -210, -60, -300, 100, -240)

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("4_npc_data")
